---
import type { NavItem } from "../types";
import ThemeToggler from "../components/ui/ThemeToggler.astro";
import BackToTop from "../components/ui/BackToTop.astro";
import Footer from "../sections/Footer.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    navItems: NavItem[];
}

const {
    title = "Martin Vuelta | Software Developer",
    description = "Personal portfolio showcasing projects, skills, and experiences",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Titillium+Web:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>
        <script is:inline>
            // Theme initialization (must run before page renders)
            const theme =
                localStorage.getItem("theme") ||
                (window.matchMedia("(prefers-color-scheme: light)").matches
                    ? "light"
                    : "dark");
            document.documentElement.classList.toggle("dark", theme === "dark");
        </script>
    </head>
    <body
        class="bg-neutral-50 dark:bg-neutral-950 text-neutral-950 dark:text-neutral-50 font-light text-base leading-7 transition-colors duration-300"
    >
        <!-- Main Content -->
        <main>
            <slot />
        </main>

        <!-- Footer -->
        <Footer />

        <!-- Theme Toggle -->
        <ThemeToggler
            id="theme-toggle"
            class="fixed bottom-24 right-8 z-50"
            aria-label="Toggle theme"
        />

        <!-- Back to Top -->
        <BackToTop
            id="back-to-top"
            class="fixed bottom-8 right-8 z-50"
            aria-label="Back to top"
        />

        <script>
            // Smooth scroll for anchor links
            document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
                anchor.addEventListener(
                    "click",
                    function (this: HTMLElement, e) {
                        const href = this.getAttribute("href");
                        if (href && href !== "#") {
                            e.preventDefault();
                            const target = document.querySelector(href);
                            if (target) {
                                const headerOffset = 80;
                                const elementPosition =
                                    target.getBoundingClientRect().top;
                                const offsetPosition =
                                    elementPosition +
                                    window.pageYOffset -
                                    headerOffset;

                                window.scrollTo({
                                    top: offsetPosition,
                                    behavior: "smooth",
                                });
                            }
                        }
                    },
                );
            });
        </script>
    </body>
</html>
