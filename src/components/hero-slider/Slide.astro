---
interface Props {
    image: string;
    title: string;
    index: number;
    isActive?: boolean;
}

const { image, title, index, isActive = false } = Astro.props;
---

<div
    class={`slide absolute inset-0 transition-all duration-1000 ease-in-out ${isActive ? "opacity-100 translate-x-0 z-[1]" : "opacity-0 translate-x-full z-0"}`}
    data-slide={index}
>
    <img src={image} alt={title} class="w-full h-full object-cover" />
</div>
