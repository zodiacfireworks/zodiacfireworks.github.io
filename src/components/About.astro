---
import type { TeamMember } from '../types';

interface Props {
  members: TeamMember[];
}

const { members } = Astro.props;

// Icon mapping for social platforms
const socialIcons: Record<string, string> = {
  twitter: 'M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z',
  facebook: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z',
  linkedin: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z',
  dribbble: 'M12 2a10 10 0 1010 10A10 10 0 0012 2zm6.2 7.5a6.7 6.7 0 01-2.5 5.3 14.9 14.9 0 00-3.3-4.4 20.3 20.3 0 015.8-.9zm-8.1 8.3a6.8 6.8 0 01-4.6-1.7 11.5 11.5 0 016.8-3.6 14.7 14.7 0 012.2 5.3zm6.5-1.5a7 7 0 01-3.6 1.7 16.6 16.6 0 00-2.2-5.5 11.3 11.3 0 015.8 3.8z',
  email: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z',
  'google-plus': 'M17 2v6h-2V6h-2V4h2V2h2zm-8 4a4 4 0 100 8 4 4 0 000-8zm0 6a2 2 0 110-4 2 2 0 010 4z',
  vimeo: 'M23 6.5a29 29 0 01-.5 5.5c-3.3 7.4-11.5 14-13.5 14s-3.3-5.7-4-10c-.3-2-.7-4-1-4s-1.3 1.3-2 2L1 12.5c2-2 4-4.7 5.5-5 1.7-.3 2.7 2 3 4.5.3 3 .7 4.5 1 4.5s1-1.3 2.5-4c1.3-2.3.7-4-2-3.5 1-6.5 9-6.5 12-2z',
};
---

<section id="about" class="py-20 bg-neutral-200 dark:bg-neutral-950 transition-colors duration-300">
  <div class="container mx-auto px-4">
    <!-- Title -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-neutral-800 dark:text-neutral-100 mb-4">About Us</h2>
      <p class="text-xl text-neutral-800 dark:text-neutral-100">Learn About our Team & Culture</p>
    </div>

    <!-- Team Members Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-3 gap-8">
      {members.map((member) => (
        <div class="profile-card group">
          <!-- Image -->
          <div class="relative overflow-hidden rounded-lg mb-6">
            <img
              src={member.image}
              alt={member.name}
              class="w-full h-80 object-cover transition-transform duration-300 group-hover:scale-110"
            />
            <!-- Overlay with role -->
            <div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-90 transition-opacity duration-300 flex items-center justify-center">
              <span class="text-white text-xl font-semibold">{member.role}</span>
            </div>
          </div>

          <!-- Info -->
          <div class="text-center">
            <h3 class="text-2xl font-bold text-neutral-800 dark:text-neutral-100 mb-3">{member.name}</h3>
            <p class="text-neutral-800 dark:text-neutral-100 mb-6 leading-relaxed">{member.description}</p>

            <!-- Social Links -->
            <div class="flex justify-center space-x-4">
              {member.social.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group w-10 h-10 rounded bg-neutral-100 dark:bg-neutral-900 hover:bg-primary dark:hover:bg-primary text-neutral-800 dark:text-neutral-100 hover:text-neutral-100 flex items-center justify-center transition-all duration-300"
                  aria-label={link.platform}
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={socialIcons[link.icon] || socialIcons.twitter} />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
