---
import Icon from "./Icon.astro";
import Button from "./Button.astro";

export interface Props {
    id: string;
    class: string;
}

const { id: elementId = "theme-toggle", class: className = "" } = Astro.props;
---

<Button
    id={elementId}
    class={`rounded-md flex items-center justify-center shadow-lg ${className}`}
    aria-label="Toggle theme"
    square={true}
    variant="dark"
>
    <Icon id="theme-icon-sun" name="sun" class="w-6 h-6 hidden dark:block" />
    <Icon id="theme-icon-moon" name="moon" class="w-6 h-6 block dark:hidden" />
</Button>

<script define:vars={{ elementId }} is:inline>
    const themeToggle = document.getElementById(elementId);
    themeToggle?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
    });
</script>
