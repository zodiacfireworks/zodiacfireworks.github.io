---
import Icon from "./Icon.astro";
import Button from "./Button.astro";

export interface Props {
    id: string;
    class: string;
}

const { id: elementId = "back-to-top", class: className = "" } = Astro.props;
---

<Button
    id={elementId}
    class={`rounded-md flex items-center justify-center shadow-lg ${className}`}
    aria-label="Back to top"
    square={true}
    variant="dark"
>
    <Icon name="up" class="w-6 h-6" />
</Button>

<script define:vars={{ elementId }} is:inline>
    const backToTop = document.getElementById(elementId);

    window.addEventListener("scroll", () => {
        if (window.pageYOffset > 500) {
            backToTop?.classList.remove("opacity-0", "invisible");
            backToTop?.classList.add("opacity-100", "visible");
        } else {
            backToTop?.classList.add("opacity-0", "invisible");
            backToTop?.classList.remove("opacity-100", "visible");
        }
    });

    window.addEventListener("load", () => {
        if (window.pageYOffset > 500) {
            backToTop?.classList.remove("opacity-0", "invisible");
            backToTop?.classList.add("opacity-100", "visible");
        } else {
            backToTop?.classList.add("opacity-0", "invisible");
            backToTop?.classList.remove("opacity-100", "visible");
        }
    });

    backToTop.addEventListener("click", (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
    });
</script>
