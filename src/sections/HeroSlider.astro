---
import type { SlideItem } from "../types";
import Slider from "../components/ui/Slider.astro";
import SliderControls from "../components/ui/SliderControls.astro";

interface Props {
    slides: SlideItem[];
}

const { slides } = Astro.props;
---

<section id="home-slider" class="relative h-screen overflow-hidden">
    <Slider slides={slides} />
    <SliderControls slideCount={slides.length} />
</section>

<script define:vars={{ slides }} is:inline>
    let currentSlide = 0;
    let direction = 1; // 1 for forward, -1 for backward
    const slideElements = document.querySelectorAll(".slide");
    const indicators = document.querySelectorAll(".slide-indicator");
    const titleElement = document.getElementById("slide-title");
    const descriptionElement = document.getElementById("slide-description");

    function showSlide(index, slideDirection = 1) {
        direction = slideDirection;

        // Update slides with slide-in/slide-out animation
        slideElements.forEach((slide, i) => {
            // Remove all transitions temporarily for repositioning
            slide.style.transition = "none";

            if (i === index) {
                // New slide coming in - position it off-screen first
                slide.classList.remove("opacity-0", "z-0");
                slide.classList.add("z-[1]");

                if (direction > 0) {
                    // Position slide off-screen to the right
                    slide.classList.remove(
                        "translate-x-0",
                        "-translate-x-full",
                    );
                    slide.classList.add("translate-x-full", "opacity-100");
                } else {
                    // Position slide off-screen to the left
                    slide.classList.remove("translate-x-0", "translate-x-full");
                    slide.classList.add("-translate-x-full", "opacity-100");
                }

                // Force reflow
                void slide.offsetWidth;

                // Re-enable transitions and slide in
                slide.style.transition = "";
                requestAnimationFrame(() => {
                    slide.classList.remove(
                        "translate-x-full",
                        "-translate-x-full",
                    );
                    slide.classList.add("translate-x-0");
                });
            } else if (i === currentSlide) {
                // Current slide going out
                slide.classList.remove("z-[1]");
                slide.classList.add("z-0");

                // Re-enable transitions
                slide.style.transition = "";

                if (direction > 0) {
                    // Sliding out to left
                    slide.classList.remove("translate-x-0", "translate-x-full");
                    slide.classList.add("-translate-x-full", "opacity-0");
                } else {
                    // Sliding out to right
                    slide.classList.remove(
                        "translate-x-0",
                        "-translate-x-full",
                    );
                    slide.classList.add("translate-x-full", "opacity-0");
                }
            } else {
                // Other slides: position them correctly for future transitions
                slide.classList.remove("opacity-100", "z-[1]");
                slide.classList.add("opacity-0", "z-0");

                // Position slides based on their relation to current index
                const distance = (i - index + slides.length) % slides.length;
                if (distance <= slides.length / 2) {
                    // Slide is ahead - position to the right
                    slide.classList.remove(
                        "-translate-x-full",
                        "translate-x-0",
                    );
                    slide.classList.add("translate-x-full");
                } else {
                    // Slide is behind - position to the left
                    slide.classList.remove("translate-x-full", "translate-x-0");
                    slide.classList.add("-translate-x-full");
                }
            }
        });

        // Update indicators
        indicators.forEach((indicator, i) => {
            if (i === index) {
                indicator.classList.remove(
                    "bg-neutral-200",
                    "dark:bg-neutral-800",
                    "hover:bg-neutral-800",
                    "dark:hover:bg-neutral-200",
                );
                indicator.classList.add("bg-primary");
            } else {
                indicator.classList.add(
                    "bg-neutral-200",
                    "dark:bg-neutral-800",
                    "hover:bg-neutral-800",
                    "dark:hover:bg-neutral-200",
                );
                indicator.classList.remove("bg-primary");
            }
        });

        // Animate text content with horizontal slide
        if (titleElement) {
            titleElement.style.opacity = "0";
            if (direction > 0) {
                titleElement.style.transform = "translateX(-30px)";
            } else {
                titleElement.style.transform = "translateX(30px)";
            }
        }
        if (descriptionElement) {
            descriptionElement.style.opacity = "0";
            if (direction > 0) {
                descriptionElement.style.transform = "translateX(-30px)";
            } else {
                descriptionElement.style.transform = "translateX(30px)";
            }
        }

        // Update text content after fade out
        setTimeout(() => {
            if (titleElement) titleElement.textContent = slides[index].title;
            if (descriptionElement && slides[index].description) {
                descriptionElement.textContent = slides[index].description;
            }

            // Reset position for slide-in from opposite direction
            if (titleElement) {
                if (direction > 0) {
                    titleElement.style.transform = "translateX(30px)";
                } else {
                    titleElement.style.transform = "translateX(-30px)";
                }
            }
            if (descriptionElement) {
                if (direction > 0) {
                    descriptionElement.style.transform = "translateX(30px)";
                } else {
                    descriptionElement.style.transform = "translateX(-30px)";
                }
            }

            // Animate text content in
            setTimeout(() => {
                if (titleElement) {
                    titleElement.style.opacity = "1";
                    titleElement.style.transform = "translateX(0)";
                }
                if (descriptionElement) {
                    descriptionElement.style.opacity = "1";
                    descriptionElement.style.transform = "translateX(0)";
                }
            }, 50);
        }, 400);

        currentSlide = index;
    }

    // Auto-advance slides
    let autoAdvance = setInterval(() => {
        const newIndex =
            currentSlide === slides.length - 1 ? 0 : currentSlide + 1;
        showSlide(newIndex, 1);
    }, 8000);

    // Function to reset auto-advance timer
    function resetAutoAdvance() {
        clearInterval(autoAdvance);
        autoAdvance = setInterval(() => {
            const newIndex =
                currentSlide === slides.length - 1 ? 0 : currentSlide + 1;
            showSlide(newIndex, 1);
        }, 8000);
    }

    // Previous slide
    document.getElementById("prev-slide")?.addEventListener("click", () => {
        const newIndex =
            currentSlide === 0 ? slides.length - 1 : currentSlide - 1;
        showSlide(newIndex, -1);
        resetAutoAdvance();
    });

    // Next slide
    document.getElementById("next-slide")?.addEventListener("click", () => {
        const newIndex =
            currentSlide === slides.length - 1 ? 0 : currentSlide + 1;
        showSlide(newIndex, 1);
        resetAutoAdvance();
    });

    // Indicator clicks
    indicators.forEach((indicator, index) => {
        indicator.addEventListener("click", () => {
            // Handle circular direction for wrap-around
            let slideDirection;
            if (index > currentSlide) {
                slideDirection = 1;
            } else if (index < currentSlide) {
                slideDirection = -1;
            } else {
                return; // Same slide, do nothing
            }

            // Check if wrapping around would be shorter
            const forwardDistance =
                index > currentSlide
                    ? index - currentSlide
                    : slides.length - currentSlide + index;
            const backwardDistance =
                index < currentSlide
                    ? currentSlide - index
                    : currentSlide + (slides.length - index);

            // Use the shorter path for circular navigation
            if (backwardDistance < forwardDistance) {
                slideDirection = -1;
            } else if (forwardDistance < backwardDistance) {
                slideDirection = 1;
            }

            showSlide(index, slideDirection);
            resetAutoAdvance();
        });
    });

    // Pause on hover
    const sliderContainer = document.querySelector(".slider-container");
    sliderContainer?.addEventListener("mouseenter", () => {
        clearInterval(autoAdvance);
    });

    sliderContainer?.addEventListener("mouseleave", () => {
        resetAutoAdvance();
    });

    // Keyboard navigation
    document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") {
            const newIndex =
                currentSlide === 0 ? slides.length - 1 : currentSlide - 1;
            showSlide(newIndex, -1);
            resetAutoAdvance();
        } else if (e.key === "ArrowRight") {
            const newIndex =
                currentSlide === slides.length - 1 ? 0 : currentSlide + 1;
            showSlide(newIndex, 1);
            resetAutoAdvance();
        }
    });
</script>
