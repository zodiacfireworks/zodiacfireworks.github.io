---
import type { SlideItem } from "../types";
import Slider from "../components/ui/Slider/Slider.astro";

interface Props {
    id: string;
    slides: SlideItem[];
    nextSectionId: string;
}

const { id: sectionId, slides, nextSectionId } = Astro.props;
---

<section id={sectionId} class="relative h-screen overflow-hidden">
    <Slider slides={slides} nextSectionId={nextSectionId} />
</section>
