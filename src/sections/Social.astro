---
import Icon from "../components/ui/Icon.astro";

interface SocialPlatform {
    name: string;
    url: string;
    icon: string;
}

const socialPlatforms: SocialPlatform[] = [
    {
        name: "Twitter",
        url: "https://twitter.com/zodiacfireworks",
        icon: "twitter",
    },
    {
        name: "GitHub",
        url: "https://github.com/zodiacfireworks",
        icon: "github",
    },
    {
        name: "LinkedIn",
        url: "https://linkedin.com/in/martinvuelta",
        icon: "linkedin",
    },
    {
        name: "Dribbble",
        url: "#",
        icon: "dribbble",
    },
    {
        name: "Facebook",
        url: "#",
        icon: "facebook",
    },
    {
        name: "Instagram",
        url: "#",
        icon: "instagram",
    },
    {
        name: "YouTube",
        url: "#",
        icon: "youtube",
    },
];
---

<section
    id="social-area"
    class="py-20 bg-neutral-100 dark:bg-neutral-900 transition-colors duration-300"
>
    <div class="container mx-auto px-4">
        <nav class="social-nav">
            <ul class="flex flex-wrap justify-center gap-6">
                {
                    socialPlatforms.map((platform) => (
                        <li>
                            <a
                                href={platform.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group flex items-center justify-center w-16 h-16 rounded-md bg-neutral-200 dark:bg-neutral-950 hover:bg-primary dark:hover:bg-primary transition-all duration-300 transform hover:scale-110"
                                aria-label={`Follow on ${platform.name}`}
                                title={`Follow on ${platform.name}`}
                            >
                                <Icon
                                    name={platform.icon}
                                    class="w-8 h-8 text-neutral-800 dark:text-neutral-50 group-hover:text-neutral-50"
                                />
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</section>
