---
import Icon from "../../components/ui/Icon.astro";

interface Props {
    slideCount: number;
}

const { slideCount } = Astro.props;
---

<div
    class="absolute bottom-0 left-0 right-0 h-12 bg-neutral-50 dark:bg-neutral-900 z-30 flex items-center justify-between transition-colors duration-300"
>
    <!-- Navigation Arrows -->
    <div class="flex">
        <button
            id="prev-slide"
            class="w-12 h-12 bg-neutral-200 dark:bg-neutral-950 hover:bg-primary dark:hover:bg-primary transition-colors flex items-center justify-center"
            aria-label="Previous slide"
        >
            <Icon
                name="left"
                class="w-4 h-4 text-neutral-950 dark:text-neutral-50"
            />
        </button>
        <button
            id="next-slide"
            class="w-12 h-12 bg-neutral-200 dark:bg-neutral-950 hover:bg-primary dark:hover:bg-primary transition-colors flex items-center justify-center ml-1"
            aria-label="Next slide"
        >
            <Icon
                name="right"
                class="w-4 h-4 text-neutral-950 dark:text-neutral-50"
            />
        </button>
    </div>

    <!-- Slide Indicators -->
    <ul id="slide-list" class="flex space-x-3">
        {
            Array.from({ length: slideCount }, (_, index) => (
                <li>
                    <button
                        class={`slide-indicator w-3 h-3 rounded-sm transition-colors ${index === 0 ? "bg-primary" : "bg-neutral-200 dark:bg-neutral-800 hover:bg-neutral-800 dark:hover:bg-neutral-200"}`}
                        data-slide={index}
                        aria-label={`Go to slide ${index + 1}`}
                    />
                </li>
            ))
        }
    </ul>

    <!-- Next Section Arrow -->
    <a
        href="#work"
        class="w-12 h-12 bg-neutral-200 dark:bg-neutral-950 hover:bg-primary dark:hover:bg-primary transition-colors flex items-center justify-center"
        aria-label="Scroll to next section"
    >
        <Icon
            name="up"
            class="w-6 h-6 text-neutral-800 dark:text-neutral-100"
        />
    </a>
</div>
