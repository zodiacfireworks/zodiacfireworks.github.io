---
import MainLayout from "../layouts/MainLayout.astro";
import HeroSlider from "../sections/HeroSlider.astro";
import Navigation from "../components/Navigation.astro";
import Portfolio from "../sections/Portfolio.astro";
import About from "../sections/About.astro";
import Contact from "../sections/Contact.astro";
import Social from "../sections/Social.astro";
import { slides, portfolioItems, teamMembers, navItems } from "../data";
---

<MainLayout
    title="Martin Vuelta | Software Developer & Designer"
    navItems={navItems}
>
    <!-- Hero Slider Section -->
    <HeroSlider id="home-slider" nextSectionId="work" slides={slides} />

    <!-- Navigation Menu -->
    <Navigation navItems={navItems} />

    <!-- Portfolio Section -->
    <Portfolio items={portfolioItems} />

    <!-- About Section -->
    <About members={teamMembers} />

    <!-- Contact Section -->
    <Contact />

    <!-- Social Section -->
    <Social />
</MainLayout>
