{
    "tabWidth": 4,
    "singleQuote": false,
    "printWidth": 120,
    "semi": false,
    "endOfLine": "lf",
    "trailingComma": "none",
    "bracketSameLine": true,
    "plugins": ["prettier-plugin-astro"],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        },
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
